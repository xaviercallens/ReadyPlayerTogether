# Godot-specific ignores
.godot/
*.import
export.cfg
export_presets.cfg

# Python & AI specific ignores
__pycache__/
*.py[cod]
*$py.class
.env
.env.*
venv/
env/
.venv/

# IDE & OS ignores
.vscode/
.idea/
.DS_Store
Thumbs.db

# Executables & Logs
Godot4.exe
*.log
.coverage

# Generated / External content (not part of the Godot project)
GoogleWorld/
GodotToImport/

# Large binary 3D models (keep .glb.import config, but not the binary itself)
assets/iron_giant/*.glb
assets/imported/*.glb


