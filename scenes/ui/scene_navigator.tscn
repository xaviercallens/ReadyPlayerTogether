[gd_scene load_steps=2 format=3 uid="uid://scene_navigator_ui"]

[ext_resource type="Script" path="res://scripts/ui/scene_navigator.gd" id="1_script"]

[node name="SceneNavigator" type="CanvasLayer"]
process_mode = 3
