# Projet OASIS - Environment Variables Template
# Copy this file to .env and fill in your secure credentials

# =======================================================
# GCP & GEMINI ULTRA (Server AI Backend)
# =======================================================
GCP_PROJECT_ID=oasis-ready-player-together
GEMINI_API_KEY=your_gemini_ultra_api_key_here
GCP_REGION=us-central1

# =======================================================
# GOOGLE FLOW & IMAGEN (GenAI Asset Pipeline)
# =======================================================
# Session token retrieved from authenticated Google Flow session
GOOGLE_FLOW_SESSION_TOKEN=your_google_flow_session_token_here

# =======================================================
# GITHUB (CI/CD & Remote Sync)
# =======================================================
GITHUB_TOKEN=your_github_personal_access_token_here

# =======================================================
# READY PLAYER ME
# =======================================================
RPM_SUBDOMAIN=your_custom_rpm_subdomain
